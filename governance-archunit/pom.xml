<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.roconmachine</groupId>
    <artifactId>governance-archunit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Governance :: ArchUnit</name>
    <description>
        Reusable ArchUnit rule factories - layering, naming, and governance
        annotation enforcement (e.g. "@Service methods must carry @Auditable")
        - packaged once so every service's own test suite enforces the same
        architectural policy instead of each team writing (or skipping) its
        own ArchUnit rules from scratch.

        This is a test-scope library, not auto-configured at runtime like
        governance-core/audit/http-logging: consuming services add it with
        &lt;scope&gt;test&lt;/scope&gt; and reference the rule factories from their own
        @AnalyzeClasses test class - see README for the exact wiring, since
        ArchUnit's @AnalyzeClasses must be declared on the consuming
        service's own test class (it isn't inherited from a base class).
    </description>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencies>
        <!-- Compile scope here so THIS module builds; consuming services should
             still declare their own <scope>test</scope> dependency on this
             artifact, which is the standard pattern for test-fixture libraries
             and keeps ArchUnit off their main compile classpath. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
        </dependency>

        <!-- Referenced only for annotation-type checks (@Service, @RestController,
             @Repository, @Autowired) - practically universal in a Spring Boot
             project, so not made optional. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
